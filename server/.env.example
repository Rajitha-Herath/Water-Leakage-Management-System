NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/water_leakage
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=30m
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=8

# Twilio WhatsApp (optional for local dashboard/mobile development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_WEBHOOK_URL=https://your-domain.example/api/webhooks/twilio/whatsapp

